# Nexus v3 — variables de entorno (todo opcional salvo la API key de nube).
# Copiar este archivo a `.env` en la RAÍZ del proyecto (el server carga `<raiz>/.env`).
# Los valores de config.yaml se pueden sobrescribir por entorno; nunca al revés.

# --- Cerebro (datos persistentes) -------------------------------------------
# Ruta del brain PROPIO de nexus-v3. Si no se define, manda config.yaml brain.path
# y, en su defecto, ./brain. NO usar NEXUS_BRAIN (pertenece a supernexus-v2).
# NEXUS_V3_BRAIN=./brain

# Directorio de datos internos (sesiones, eventos, board, checkpoints).
# NEXUS_V3_DATA=./data

# --- Servidor ---------------------------------------------------------------
# NEXUS_HOST=127.0.0.1
# NEXUS_PORT=8765            # 0 = puerto libre (modo app Electron)

# --- Modelos ----------------------------------------------------------------
# Ollama local. Si tu Ollama no está en localhost, definilo acá.
# OLLAMA_HOST=http://localhost:11434

# Nube (opt-in). Sin key, el arnés funciona solo con modelos locales.
# OPENCODE_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- Búsqueda web -----------------------------------------------------------
# Instancia SearXNG para web_search (sin ella cae a Wikipedia).
# SEARXNG_URL=http://localhost:8080

# --- Tareas / concurrencia --------------------------------------------------
# Duración del claim (lease) del board, en segundos.
# NEXUS_TASK_LEASE_S=900

# --- Voz --------------------------------------------------------------------
# TTS: usa Piper si está instalado; si no, la voz nativa de Windows (SAPI).
# NEXUS_TTS_VOICE=
# NEXUS_TTS_ENDPOINT=
# STT: endpoint HTTP compatible (por defecto http://127.0.0.1:8789).
# NEXUS_STT_ENDPOINT=http://127.0.0.1:8789
# NEXUS_STT_TIMEOUT_S=30
# NEXUS_STT_RETRIES=2
# NEXUS_VOICE_LANG=es
# Fallback local (solo si faster-whisper está instalado).
# NEXUS_WHISPER_MODEL=base

# --- Otros ------------------------------------------------------------------
# NEXUS_CHECKPOINTS_DIR=./data/checkpoints
# NEXUS_NODE_NAME=
# NEXUS_PROVIDER_MODELS_TTL=300
