# Nexus v3 — variables env (todo via config.yaml + env, nada hardcodeado)
# Copiar a .env y completar

# Cerebro — ruta generica (local ./brain o externa si compartis datos)
# Ej: NEXUS_BRAIN=C:/mis-datos/nexus/brain  -> usa esas BDs en vez de ./brain
NEXUS_BRAIN=./brain

# Nube (opcional, opt-in)
OPENCODE_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Proveedores (sobrescriben config.yaml si estan definidos)
# OLLAMA_BASE_URL=http://localhost:11434
# LLAMACPP_BASE_URL=http://localhost:8080
# LLAMACPP_FALLBACK_URL=http://localhost:8000

# Directorios datos
# NEXUS_DATA_DIR=./data
# NEXUS_WORKSPACE_DIR=./workspace
