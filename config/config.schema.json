{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Nexus v3 config.yaml",
  "description": "Unica fuente de verdad — BLUEPRINT.md §4. Nada harcodeado.",
  "type": "object",
  "required": [
    "project",
    "brain",
    "session",
    "agent_loop",
    "scope",
    "compaction",
    "providers",
    "router",
    "hooks"
  ],
  "properties": {
    "project": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "brain": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "description": "May contain ${NEXUS_BRAIN:-./brain}"
        },
        "hierarchical_tiers": {
          "type": "object",
          "properties": {
            "working": {
              "type": "object",
              "required": [
                "capacity",
                "ttl_h"
              ],
              "properties": {
                "capacity": {
                  "type": "integer",
                  "minimum": 0
                },
                "ttl_h": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "episodic": {
              "type": "object",
              "required": [
                "capacity",
                "ttl_h"
              ],
              "properties": {
                "capacity": {
                  "type": "integer",
                  "minimum": 0
                },
                "ttl_h": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "semantic": {
              "type": "object",
              "required": [
                "capacity",
                "ttl_h"
              ],
              "properties": {
                "capacity": {
                  "type": "integer",
                  "minimum": 0
                },
                "ttl_h": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "session": {
      "type": "object",
      "required": [
        "db_path"
      ],
      "properties": {
        "db_path": {
          "type": "string"
        },
        "wal": {
          "type": "boolean"
        },
        "fts": {
          "type": "boolean"
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1000
        },
        "compact_threshold": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 1.0
        },
        "keep_recent": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "agent_loop": {
      "type": "object",
      "properties": {
        "max_iterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "max_tokens_per_turn": {
          "type": "integer",
          "minimum": 512
        },
        "error_policy": {
          "type": "object",
          "properties": {
            "retry": {
              "type": "integer",
              "minimum": 0
            },
            "replan": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "heartbeat_ms": {
          "type": "integer",
          "minimum": 100
        }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "properties": {
        "allowed_roots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deny_patterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "max_read_bytes": {
          "type": "integer",
          "minimum": 1024
        },
        "max_file_read_bytes": {
          "type": "integer",
          "minimum": 1024
        },
        "allow_network": {
          "type": "boolean"
        },
        "allow_mutating_without_confirm": {
          "type": "boolean"
        },
        "permission": {
          "type": "string",
          "enum": [
            "read_only",
            "workspace_write",
            "full"
          ]
        }
      },
      "additionalProperties": false
    },
    "compaction": {
      "type": "object",
      "properties": {
        "layers": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "snip",
              "micro",
              "budget",
              "summary"
            ]
          }
        },
        "snip": {
          "type": "object",
          "properties": {
            "keep_recent": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "micro": {
          "type": "object",
          "properties": {
            "placeholder": {
              "type": "string"
            }
          }
        },
        "budget": {
          "type": "object",
          "properties": {
            "max_tool_result_chars": {
              "type": "integer",
              "minimum": 100
            },
            "persist_dir": {
              "type": "string"
            }
          }
        },
        "summary": {
          "type": "object",
          "properties": {
            "model_hint": {
              "type": "string"
            },
            "max_summary_tokens": {
              "type": "integer"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "providers": {
      "type": "object",
      "properties": {
        "ollama": {
          "type": "object",
          "properties": {
            "base_url": {
              "type": "string"
            },
            "timeout_s": {
              "type": "number"
            },
            "models": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "enabled": {
              "type": "boolean"
            }
          },
          "additionalProperties": true
        },
        "llamacpp": {
          "type": "object",
          "properties": {
            "base_url": {
              "type": "string"
            },
            "fallback_url": {
              "type": "string"
            },
            "timeout_s": {
              "type": "number"
            },
            "models": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "ctx": {
              "type": "integer"
            },
            "enabled": {
              "type": "boolean"
            }
          },
          "additionalProperties": true
        },
        "cloud": {
          "type": "object",
          "properties": {
            "base_url": {
              "type": "string"
            },
            "api_key": {
              "type": "string"
            },
            "auth_style": {
              "type": "string",
              "enum": [
                "bearer",
                "x-api-key",
                "none"
              ]
            },
            "models": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "enabled": {
              "type": "boolean"
            },
            "timeout_s": {
              "type": "number"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "base_url": {
            "type": "string"
          },
          "api_key": {
            "type": "string"
          },
          "auth_style": {
            "type": "string",
            "enum": [
              "bearer",
              "x-api-key",
              "none"
            ]
          },
          "models": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "enabled": {
            "type": "boolean"
          },
          "timeout_s": {
            "type": "number"
          },
          "fallback_url": {
            "type": "string"
          },
          "ctx": {
            "type": "integer"
          }
        },
        "additionalProperties": true
      }
    },
    "router": {
      "type": "object",
      "properties": {
        "strategy": {
          "type": "string",
          "enum": [
            "thompson",
            "vram",
            "tier",
            "manual"
          ]
        },
        "vram_budget_gb": {
          "type": "number",
          "minimum": 0,
          "description": "0 = auto-detectar VRAM (nvidia-smi) o RAM/4 sin GPU"
        },
        "prefer_speed": {
          "type": "boolean"
        },
        "fallback_order": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "hooks": {
      "type": "object",
      "properties": {
        "phases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "security_gate": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}