{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Nexus v3 config.yaml",
  "description": "Unica fuente de verdad — BLUEPRINT.md §4. Nada harcodeado.",
  "type": "object",
  "required": [
    "project",
    "brain",
    "session",
    "agent_loop",
    "scope",
    "compaction",
    "providers",
    "router",
    "hooks"
  ],
  "properties": {
    "project": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "brain": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "description": "May contain ${NEXUS_V3_BRAIN:-./brain} (brain propio de nexus-v3; NEXUS_BRAIN pertenece a otro proyecto)"
        },
        "hierarchical_tiers": {
          "type": "object",
          "properties": {
            "working": {
              "type": "object",
              "required": [
                "capacity",
                "ttl_h"
              ],
              "properties": {
                "capacity": {
                  "type": "integer",
                  "minimum": 0
                },
                "ttl_h": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "episodic": {
              "type": "object",
              "required": [
                "capacity",
                "ttl_h"
              ],
              "properties": {
                "capacity": {
                  "type": "integer",
                  "minimum": 0
                },
                "ttl_h": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "semantic": {
              "type": "object",
              "required": [
                "capacity",
                "ttl_h"
              ],
              "properties": {
                "capacity": {
                  "type": "integer",
                  "minimum": 0
                },
                "ttl_h": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "session": {
      "type": "object",
      "required": [
        "db_path"
      ],
      "properties": {
        "db_path": {
          "type": "string"
        },
        "wal": {
          "type": "boolean"
        },
        "fts": {
          "type": "boolean"
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1000
        },
        "compact_threshold": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 1.0
        },
        "keep_recent": {
          "type": "integer",
          "minimum": 1
        },
        "event_db_path": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "agent_loop": {
      "type": "object",
      "properties": {
        "max_iterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "max_tokens_per_turn": {
          "type": "integer",
          "minimum": 512
        },
        "error_policy": {
          "type": "object",
          "properties": {
            "retry": {
              "type": "integer",
              "minimum": 0
            },
            "replan": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "anti_loop": {
          "type": "object",
          "properties": {
            "repeat_warn": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "repeat_stop": {
              "type": "integer",
              "minimum": 1
            },
            "failures_warn": {
              "type": "integer",
              "minimum": 1
            },
            "failures_stop": {
              "type": "integer",
              "minimum": 1
            },
            "tool_warn": {
              "type": "integer",
              "minimum": 1
            },
            "tool_stop": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "heartbeat_ms": {
          "type": "integer",
          "minimum": 100
        },
        "auto_apply": {
          "type": "string",
          "enum": [
            "auto",
            "assisted",
            "approve"
          ]
        },
        "budget": {
          "type": "object",
          "properties": {
            "max_iterations": {
              "type": "integer",
              "minimum": 1
            },
            "max_tokens": {
              "type": "integer",
              "minimum": 1
            },
            "max_wall_ms": {
              "type": "number",
              "minimum": 1000
            },
            "max_tool_calls": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "approval": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["auto", "assisted", "strict", "never"]
        },
        "timeout_s": {
          "type": "number",
          "minimum": 0,
          "maximum": 3600
        },
        "mcp_read_only": {
          "type": "array",
          "items": { "type": "string" }
        },
        "hard_deny": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "guard": {
      "type": "object",
      "properties": {
        "sequence": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "mode": { "type": "string", "enum": ["heuristic", "llm", "auto"] },
            "window": { "type": "integer", "minimum": 1, "maximum": 200 },
            "repeat_medium": { "type": "integer", "minimum": 2 },
            "failure_streak_medium": { "type": "integer", "minimum": 1 },
            "timeout_s": { "type": "number", "minimum": 0.1, "maximum": 60 },
            "model_hint": { "type": "string" },
            "policy": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "file": { "type": "string" },
                "rules": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": { "type": "string" },
                      "action": {
                        "type": "string",
                        "enum": ["deny", "high", "medium", "approve", "allow", "low"]
                      },
                      "tools": {
                        "oneOf": [
                          { "type": "string" },
                          { "type": "array", "items": { "type": "string" } }
                        ]
                      },
                      "pattern": { "type": "string" },
                      "path_pattern": { "type": "string" },
                      "case_sensitive": { "type": "boolean" },
                      "reason": { "type": "string" }
                    },
                    "required": ["action"],
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "properties": {
        "allowed_roots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deny_patterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deny_patterns_full": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "max_read_bytes": {
          "type": "integer",
          "minimum": 1024
        },
        "max_file_read_bytes": {
          "type": "integer",
          "minimum": 1024
        },
        "allow_network": {
          "type": "boolean"
        },
        "allow_mutating_without_confirm": {
          "type": "boolean"
        },
        "require_confirm_mutating": {
          "type": "boolean"
        },
        "permission": {
          "type": "string",
          "enum": [
            "read_only",
            "read-only",
            "workspace_write",
            "workspace-write",
            "full",
            "danger-full-access"
          ]
        }
      },
      "additionalProperties": false
    },
    "compaction": {
      "type": "object",
      "properties": {
        "layers": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "snip",
              "micro",
              "budget",
              "summary"
            ]
          }
        },
        "snip": {
          "type": "object",
          "properties": {
            "keep_recent": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "micro": {
          "type": "object",
          "properties": {
            "keep_recent": {
              "type": "integer",
              "minimum": 0
            },
            "placeholder": {
              "type": "string"
            }
          }
        },
        "budget": {
          "type": "object",
          "properties": {
            "max_tool_result_chars": {
              "type": "integer",
              "minimum": 100
            },
            "persist_dir": {
              "type": "string"
            }
          }
        },
        "summary": {
          "type": "object",
          "properties": {
            "model_hint": {
              "type": "string"
            },
            "min_tokens": {
              "type": "integer",
              "minimum": 128
            },
            "ratio": {
              "type": "number",
              "minimum": 0.05,
              "maximum": 0.5
            },
            "max_tokens": {
              "type": "integer",
              "minimum": 256
            },
            "minimum_progress_messages": {
              "type": "integer",
              "minimum": 0
            },
            "failure_cooldown_s": {
              "type": "number",
              "minimum": 0
            },
            "handoff_prefix": {
              "type": "string"
            },
            "max_summary_tokens": {
              "type": "integer"
            }
          }
        },
        "prune": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "keep_recent": {
              "type": "integer",
              "minimum": 0
            },
            "max_tool_result_chars": {
              "type": "integer",
              "minimum": 200
            }
          }
        }
      },
      "additionalProperties": false
    },
    "providers": {
      "type": "object",
      "properties": {
        "ollama": {
          "type": "object",
          "properties": {
            "base_url": {
              "type": "string"
            },
            "timeout_s": {
              "type": "number"
            },
            "keep_alive": {
              "type": "string"
            },
            "embed_url": {
              "type": "string",
              "description": "URL de Ollama para embeddings (RAG). Default: OLLAMA_HOST o base_url."
            },
            "options": {
              "type": "object",
              "additionalProperties": true
            },
            "models": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "enabled": {
              "type": "boolean"
            }
          },
          "additionalProperties": true
        },
        "llamacpp": {
          "type": "object",
          "properties": {
            "base_url": {
              "type": "string"
            },
            "fallback_url": {
              "type": "string"
            },
            "timeout_s": {
              "type": "number"
            },
            "models": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "ctx": {
              "type": "integer"
            },
            "enabled": {
              "type": "boolean"
            }
          },
          "additionalProperties": true
        },
        "cloud": {
          "type": "object",
          "properties": {
            "base_url": {
              "type": "string"
            },
            "api_key": {
              "type": "string"
            },
            "auth_style": {
              "type": "string",
              "enum": [
                "bearer",
                "x-api-key",
                "none"
              ]
            },
            "models": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "enabled": {
              "type": "boolean"
            },
            "timeout_s": {
              "type": "number"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "base_url": {
            "type": "string"
          },
          "api_key": {
            "type": "string"
          },
          "auth_style": {
            "type": "string",
            "enum": [
              "bearer",
              "x-api-key",
              "none"
            ]
          },
          "models": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "enabled": {
            "type": "boolean"
          },
          "timeout_s": {
            "type": "number"
          },
          "fallback_url": {
            "type": "string"
          },
          "ctx": {
            "type": "integer"
          }
        },
        "additionalProperties": true
      }
    },
    "router": {
      "type": "object",
      "properties": {
        "strategy": {
          "type": "string",
          "enum": [
            "thompson",
            "vram",
            "tier",
            "manual"
          ]
        },
        "vram_budget_gb": {
          "type": "number",
          "minimum": 0,
          "description": "0 = auto-detectar VRAM (nvidia-smi) o RAM/4 sin GPU"
        },
        "prefer_speed": {
          "type": "boolean"
        },
        "prefer_models": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Modelos preferidos por encima del mapeo por gema (orden = prioridad). Un multimodal cubre texto + vision y evita la recarga en frio (~45 s) que cuesta cada cambio de modelo en Ollama. Vacio = modelo propio de cada gema."
        },
        "fallback_order": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "hooks": {
      "type": "object",
      "properties": {
        "phases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "security_gate": {
          "type": "boolean"
        },
        "files": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "dir": {
              "type": "string"
            },
            "timeout_s": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 120
            },
            "fail_closed": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "checkpoints": {
      "type": "object",
      "properties": {
        "git": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "auto_before_apply_patch": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "reminders": {
      "type": "object",
      "properties": {
        "min_every_s": {
          "type": "integer",
          "minimum": 1
        },
        "max_active": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "skills": {
      "type": "object",
      "properties": {
        "roots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "include_default_roots": {
          "type": "boolean"
        },
        "watch": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "memory": {
      "type": "object",
      "properties": {
        "agent_write_enabled": {
          "type": "boolean"
        },
        "learn_min_chars": {
          "type": "integer",
          "minimum": 1
        },
        "auto_insight_persist": {
          "type": "boolean"
        },
        "auto_extract": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "window": {
              "type": "integer",
              "minimum": 2
            },
            "max_facts": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "inject": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            },
            "max_terms": {
              "type": "integer",
              "minimum": 2,
              "maximum": 16
            },
            "min_terms": {
              "type": "integer",
              "minimum": 1
            },
            "min_matches": {
              "type": "integer",
              "minimum": 1
            },
            "max_chars": {
              "type": "integer",
              "minimum": 200
            },
            "snippet_chars": {
              "type": "integer",
              "minimum": 80
            },
            "rerank": {
              "type": "string",
              "enum": ["auto", "off", "force"]
            },
            "rerank_timeout_ms": {
              "type": "integer",
              "minimum": 100,
              "maximum": 30000
            },
            "rerank_candidates": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "assignment": {
      "type": "object",
      "properties": {
        "overrides": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "concurrency": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "parallel_tools": { "type": "boolean" },
        "max_threads": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "learning": {
      "type": "object",
      "properties": {
        "distill_on_compact": {
          "type": "boolean"
        },
        "distill_llm": {
          "type": "boolean"
        },
        "distill_model": {
          "type": "string"
        },
        "distill_min_interval_s": {
          "type": "number",
          "minimum": 0
        },
        "distill_on_session_end": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "voice": {
      "type": "object",
      "properties": {
        "stt_endpoint": { "type": "string" },
        "stt_timeout_s": { "type": "number", "minimum": 1 },
        "stt_retries": { "type": "integer", "minimum": 0 },
        "language": { "type": "string" },
        "vad_frame_ms": { "type": "integer", "minimum": 10 },
        "vad_threshold": { "type": "number", "minimum": 0 },
        "vad_pre_roll_ms": { "type": "integer", "minimum": 0 },
        "vad_hangover_ms": { "type": "integer", "minimum": 0 },
        "vad_min_speech_ms": { "type": "integer", "minimum": 0 },
        "tts_endpoint": { "type": "string" }
      },
      "additionalProperties": false
    },
    "updates": {
      "type": "object",
      "properties": {
        "manifest_url": { "type": "string" },
        "timeout_s": { "type": "number", "minimum": 1 },
        "auto_apply": { "type": "boolean" },
        "auto": { "type": "boolean" },
        "apply_on_start": { "type": "boolean" },
        "git_remote": { "type": "string" },
        "git_branch": { "type": "string" },
        "check_interval_s": { "type": "number", "minimum": 0 },
        "build_on_update": { "type": "boolean" },
        "fetch_timeout_s": { "type": "number", "minimum": 1 },
        "pull_timeout_s": { "type": "number", "minimum": 1 },
        "build_timeout_s": { "type": "number", "minimum": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}